# What must never enter the build context.
#
# The first two entries are the ones that matter for more than image size.
#
# .env holds DATABASE_URL, both token secrets and VAULT_ENCRYPTION_KEY. Anything
# copied into a layer stays in that layer forever - `docker history` reads it
# back out even after a later step deletes the file - and this image is pushed
# to a registry. Secrets arrive at runtime through env_file instead.
#
# .git carries every secret that was ever committed and then removed, which is
# the same leak with a longer memory.
.env
.env.*
.admin-password.txt
.git
.gitignore

# Rebuilt inside the image. Copying a host node_modules would also drag in
# binaries compiled for Windows into an Alpine container.
node_modules
dist

# Regenerated by `prisma generate` during the build. The host copy is
# gitignored and can be stale.
src/generated

# Nothing the server needs in production.
scripts/smoke.mjs
scripts/perf.ts
scripts/resetFlow.ts
scripts/mailTest.ts
scripts/tenantIsolation.ts
scripts/permissionScope.ts
scripts/apiMatrix.ts
scripts/chatBus.ts
scripts/responseLeaks.ts
**/*.test.ts
README.md
eslint.config.mjs
Dockerfile
.dockerignore
