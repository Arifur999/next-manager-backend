# Copy to .env.docker and fill in. Never commit the filled copy.
#
# Then always:  docker compose --env-file .env.docker up -d --build
# Without the flag compose substitutes from .env, which is the DEV environment.
#
# Compose reads THIS file for the variables it substitutes (${...} above) and
# passes it to the api container as env_file. The web container takes only the
# three values it needs, listed explicitly in docker-compose.yml.

# ---------------------------------------------------------------- the database
# Only the containers can reach it - nothing is published - but the password is
# still what stands between a compromised container and the data.
POSTGRES_USER=naxified
POSTGRES_PASSWORD=change_me_before_first_run
POSTGRES_DB=naxified

# ------------------------------------------------------------------ the origin
# Where a browser reaches this stack. Baked into the web bundle at BUILD time,
# so changing it needs `docker compose build web`, not a restart.
#   local:      https://localhost
#   production: https://app.yourdomain.com
PUBLIC_ORIGIN=https://localhost


# ----------------------------------------------------------------- the secrets
# Long random strings, different from each other. The web container is given
# ACCESS_TOKEN_SECRET as JWT_ACCESS_SECRET because proxy.ts verifies access
# tokens itself - if the two ever differ, every signed-in person is bounced to
# the login page.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# 64 hex characters - a 32-byte key. Credentials in the vault are encrypted
# with this, and there is no way to read them back if it is lost or changed.
VAULT_ENCRYPTION_KEY=

# ------------------------------------------------------- the first person in
# Created on first boot if absent.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --------------------------------------------------------------------- ports
# HTTP only redirects to HTTPS. Both are published.
HTTP_PORT=80
HTTPS_PORT=443

# ---------------------------------------------------------------- the cert
# nginx needs docker/nginx/certs/fullchain.pem and privkey.pem. In production
# those are your CA's. For a local run, make a self-signed pair:
#
#   openssl req -x509 -newkey rsa:2048 -nodes -days 365 \
#     -keyout docker/nginx/certs/privkey.pem \
#     -out    docker/nginx/certs/fullchain.pem \
#     -subj "/CN=localhost" -addext "subjectAltName=DNS:localhost"
#
# A browser will warn once and let you continue; curl needs -k. This is not
# optional - see docker/nginx/default.conf for why plain http cannot log in.
