NODE_ENV=development
PORT=5000

# Local PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/naxified"

# JWT. ACCESS_TOKEN_SECRET must match the frontend's JWT_ACCESS_SECRET -
# src/proxy.ts verifies the access token locally before letting a route render.
ACCESS_TOKEN_SECRET=change_this_access_secret
REFRESH_TOKEN_SECRET=change_this_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend origin(s) for CORS. Comma-separated for more than one.
FRONTEND_URL=http://localhost:3000

# Super admin, created on boot by utils/seed.ts. This account can reach every
# workspace, so treat the password like any other production secret: set it in
# .env (gitignored), never here - this file is committed.
#
#   SUPER_ADMIN_PASSWORD=$(openssl rand -base64 24)
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=

# Cloudinary (image uploads) - optional until uploads are wired up.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
