NODE_ENV=development
PORT=5000

# Local PostgreSQL
# Local Postgres. If your install uses trust auth the password can be omitted:
#   postgresql://postgres@localhost:5432/agencio
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/agencio"

# JWT. ACCESS_TOKEN_SECRET must match the frontend's JWT_ACCESS_SECRET -
# src/proxy.ts verifies the access token locally before letting a route render.
ACCESS_TOKEN_SECRET=change_this_access_secret
REFRESH_TOKEN_SECRET=change_this_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend origin(s) for CORS. Comma-separated for more than one.
FRONTEND_URL=http://localhost:3000

# Super admin, created on boot by utils/seed.ts. This account can reach every
# workspace, so treat the password like any other production secret: set it in
# .env (gitignored), never here - this file is committed.
#
#   SUPER_ADMIN_PASSWORD=$(openssl rand -base64 24)
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=

# Cloudinary (image uploads) - optional until uploads are wired up.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vault encryption. AES-256-GCM key for stored client credentials.
# Generate with:  openssl rand -hex 32
# Losing this loses every password in the vault. Never commit the real one.
VAULT_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Mail (password reset links). Optional.
# ---------------------------------------------------------------------------
#
# Leave these empty and the app still runs: a reset request logs the whole
# message, including the link, to the server console instead of sending it, and
# tells the caller it was not delivered. That is deliberate - a reset that
# reports success while going nowhere is the worst possible outcome - and it is
# what makes the flow testable before a mail plan is bought.
#
# SMTP rather than one provider's SDK, so switching provider is these four
# lines rather than a rewrite. Pick whichever you have:
#
#   Resend        SMTP_HOST=smtp.resend.com   PORT=587
#                 SMTP_USER=resend            SMTP_PASSWORD=re_xxxxxxxx  (API key)
#
#   Brevo         SMTP_HOST=smtp-relay.brevo.com   PORT=587
#                 SMTP_USER=<your login>      SMTP_PASSWORD=<SMTP key, not the password>
#
#   SendGrid      SMTP_HOST=smtp.sendgrid.net PORT=587
#                 SMTP_USER=apikey            SMTP_PASSWORD=SG.xxxxxxxx  (literally "apikey")
#
#   Gmail         SMTP_HOST=smtp.gmail.com    PORT=587
#                 SMTP_USER=you@gmail.com     SMTP_PASSWORD=<App Password>
#                 Requires 2-step verification on, then an App Password -
#                 your normal Google password will not work. Fine for testing;
#                 Gmail's daily send limit makes it a poor production choice.
#
# Port 465 is implicit TLS and 587 upgrades with STARTTLS. Use 587 unless the
# provider says otherwise; the code picks the right mode from the number.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The From address. Must be a domain the provider has verified, or the message
# is refused or silently binned as spam. Falls back to SMTP_USER if unset.
MAIL_FROM=
