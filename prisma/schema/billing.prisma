// Invoices. Billed in USD, like every other client-facing figure.

model Invoice {
  id             String        @id @default(uuid())
  organization_id String
  client_id      String
  project_id     String?
  /// Unique per agency, not globally - two agencies both having INV-001 is
  /// correct.
  invoice_number String
  issue_date     DateTime      @db.Date
  due_date       DateTime      @db.Date
  status         InvoiceStatus @default(draft)
  subtotal       Decimal       @default(0) @db.Decimal(15, 2)
  discount       Decimal       @default(0) @db.Decimal(15, 2)
  tax            Decimal       @default(0) @db.Decimal(15, 2)
  total          Decimal       @default(0) @db.Decimal(15, 2)
  notes          String        @default("")
  terms          String        @default("")
  deleted_at     DateTime?
  deleted_by     String?
  created_by     String?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  client   Client        @relation(fields: [client_id], references: [id], onDelete: Restrict)
  project  Project?      @relation(fields: [project_id], references: [id], onDelete: SetNull)
  items    InvoiceItem[]
  payments Payment[]

  @@unique([organization_id, invoice_number])
  @@index([organization_id])
  @@index([organization_id, status])
  @@index([organization_id, due_date])
  /// The invoices list, newest issued first.
  @@index([organization_id, issue_date(sort: Desc)])
  @@index([client_id])
  /// The project FK - deleting a project checks every invoice without it.
  @@index([project_id])
  @@map("invoices")
}

model InvoiceItem {
  id             String   @id @default(uuid())
  organization_id String
  invoice_id     String
  /// What was sold, when it came from the catalogue. Optional: a one-off line
  /// typed by hand is a real invoice line and always will be.
  service_id     String?
  description    String
  quantity       Decimal  @default(1) @db.Decimal(12, 2)
  unit_price     Decimal  @default(0) @db.Decimal(15, 2)
  /// quantity * unit_price, stored so a historical invoice cannot be restated
  /// by a change to how the total is worked out.
  amount         Decimal  @default(0) @db.Decimal(15, 2)
  sort_order     Int      @default(0)
  created_at     DateTime @default(now())

  invoice Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  /// Restrict: a service that has been billed cannot be deleted, or the line
  /// loses what it was for. Turn it off instead.
  service Service? @relation(fields: [service_id], references: [id], onDelete: Restrict)

  @@index([organization_id])
  @@index([invoice_id])
  /// The FK, and "what has this service earned".
  @@index([service_id])
  @@map("invoice_items")
}
