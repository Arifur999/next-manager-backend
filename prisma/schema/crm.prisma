// Clients and the lead pipeline that feeds them.

model Client {
  id             String       @id @default(uuid())
  organization_id String
  name           String
  company        String       @default("")
  email          String       @default("")
  phone          String       @default("")
  country        String       @default("")
  status         ClientStatus @default(active)
  /// Who brought this client in.
  ///
  /// Null is a real answer, not missing data: everything that existed before
  /// this column belongs to nobody, and a backfill that guessed would invent a
  /// fact. SetNull rather than Cascade - somebody leaving the agency must not
  /// take their clients out of the database with them.
  owner_id       String?
  notes          String       @default("")
  deleted_at     DateTime?
  deleted_by     String?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  owner        User?        @relation("ClientOwner", fields: [owner_id], references: [id], onDelete: SetNull)
  projects     Project[]
  payments     Payment[]
  invoices     Invoice[]
  credentials  Credential[]
  leads        Lead[]
  links        ClientLink[]

  @@index([organization_id])
  @@index([organization_id, status])
  /// The clients list, in the order it is shown.
  @@index([organization_id, created_at(sort: Desc)])
  /// "My clients" - the filter the sales reports and task board are built on.
  @@index([organization_id, owner_id])
  /// The FK itself. The composite above leads with organization_id, so it
  /// cannot serve a lookup on owner_id alone - which is exactly what deleting
  /// a user has to do to check this constraint.
  @@index([owner_id])
  @@map("clients")
}

/// Where work is landed: Upwork, Fiverr, Freelancer, a referral, direct.
///
/// A per-company list rather than an enum, because agencies use different
/// marketplaces and an enum would mean a migration per customer. Same shape as
/// ExpenseCategory, which solves the same problem.
///
/// Referenced by id rather than kept as free text. "Upwork", "upwork" and
/// "UpWork" typed on three different days become three marketplaces in a
/// report that quietly splits the numbers and looks fine.
model LeadSource {
  id             String   @id @default(uuid())
  organization_id String
  name           String
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organization_id, name])
  @@index([organization_id])
  @@map("lead_sources")
}

model Lead {
  id             String    @id @default(uuid())
  organization_id String
  name           String
  company        String    @default("")
  email          String    @default("")
  phone          String    @default("")
  /// Null when nobody said where it came from - which is a real answer and
  /// not the same as "direct".
  source_id      String?
  stage          LeadStage @default(new)
  /// What the deal is thought to be worth. Estimates are always USD - that is
  /// the currency the agency actually bills in.
  estimated_value_usd Decimal @default(0) @db.Decimal(15, 2)
  notes          String    @default("")
  /// Who brought this in.
  ///
  /// Null is a real answer, not missing data: everything that existed before
  /// this column belongs to nobody, and a backfill that guessed would invent a
  /// fact. SetNull rather than Cascade - somebody leaving the agency must not
  /// take their clients out of the database with them.
  owner_id       String?

  /// Set when the lead is converted, so a won deal can be traced to its client.
  converted_client_id String?
  converted_at   DateTime?
  deleted_at     DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  organization     Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  owner            User?        @relation("LeadOwner", fields: [owner_id], references: [id], onDelete: SetNull)
  source           LeadSource?  @relation(fields: [source_id], references: [id], onDelete: SetNull)
  converted_client Client?      @relation(fields: [converted_client_id], references: [id], onDelete: SetNull)
  stage_events     LeadStageEvent[]

  @@index([organization_id])
  @@index([organization_id, stage])
  /// The pipeline board, most recently touched first.
  @@index([organization_id, updated_at(sort: Desc)])
  /// "Which marketplace is actually paying" - the sales dashboard groups on
  /// this, and the FK needs an index regardless.
  @@index([source_id])
  @@index([converted_client_id])
  /// "My pipeline" - the filter a salesperson opens their own board with.
  @@index([organization_id, owner_id])
  /// The FK itself. The composite above leads with organization_id, so it
  /// cannot serve a lookup on owner_id alone - which is exactly what deleting
  /// a user has to do to check this constraint.
  @@index([owner_id])
  @@map("leads")
}

/// Where a client's work actually lives: a Drive folder, a Figma file, a
/// staging site.
///
/// Links, not uploads. An agency's files are already somewhere - copying them
/// into this product would mean a second copy to keep in step, a storage bill,
/// and a place for a client's material to leak from. A pointer is what people
/// paste into chat anyway.
///
/// Nothing here is fetched or previewed server-side. The URL is stored as
/// given and only ever rendered as a link, which keeps this from becoming a
/// way to make the server issue requests on somebody else's behalf.
model ClientLink {
  id             String    @id @default(uuid())
  organization_id String
  client_id      String
  label          String
  url            String
  notes          String    @default("")
  deleted_at     DateTime?
  created_by     String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  client Client @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  /// The client detail page: one client, newest first.
  @@index([client_id, created_at(sort: Desc)])
  @@map("client_links")
}
