// Enum values are deliberately lowercase: they travel to the client as literal
// strings and are compared there, so the wire value and the TypeScript value
// stay the same thing.

enum Role {
  // Platform. Belongs to no company, provisions and meters them, and
  // deliberately cannot read any company's money.
  super_admin

  // Inside a company. admin is the top - there is no owner above it, so the
  // last admin in a company is protected from demotion (see user.service.ts).
  admin           // finance, company state, team, settings
  sales           // clients, leads, invoices out - brings the work in
  project_manager // turns won work into projects, assigns teams, owns schedule
  operations      // does the work, logs time, submits
}

enum Currency {
  USD
  BDT
}

enum AccountType {
  paypal
  payoneer
  stripe
  wise
  bank
  cash
  bkash
  nagad
  other
}

// Why a ledger row exists. The row points back at the record that caused it
// through source_type + source_id, so any balance can be explained.
enum LedgerSource {
  opening_balance
  payment
  expense
  team_payout
  owner_withdrawal
  exchange_out
  exchange_in
  due_received
  due_payment
  // Borrowed money arriving, and instalments going back out. Both move a
  // real account; neither is revenue or cost, which is why profit and loss
  // reads payments and expenses rather than the ledger.
  loan_received
  loan_repayment
  // Profit handed to an owner. A sibling of owner_withdrawal, not of expense.
  shareholder_distribution
  adjustment
}

enum ClientStatus {
  active
  inactive
  archived
}

enum LeadStage {
  new
  contacted
  proposal
  negotiating
  won
  lost
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum InvoiceStatus {
  draft
  sent
  partially_paid
  paid
  overdue
  cancelled
}

// "employee" categories are salary-like costs that should be excluded from
// operating-expense reporting; "general" is everything else.
enum ExpenseCategoryType {
  general
  employee
}

enum PayoutType {
  salary
  project_bonus
  commission
  reimbursement
}

enum WithdrawalType {
  personal
  reinvestment
}

// Direction of a due-payment movement, from the agency's point of view.
enum DueDirection {
  received // money came in from that person
  payment  // money went out to that person
}

enum CredentialAction {
  created
  updated
  viewed
  revealed
  deleted
}

// Where a stored USD -> BDT rate came from. An api rate is the mid-market rate
// and is only ever a suggestion; the rate actually received on an exchange is
// recorded on the exchange itself.
enum RateSource {
  api
  manual
}

// What a KpiTarget can be set against.
//
// An enum rather than free text on purpose: a target on a metric the engine
// cannot compute is a target nobody will ever be scored against, which is
// worse than having no target at all. Adding a metric here is deliberate, and
// the migration is the reminder to also teach the engine to compute it.
enum KpiMetric {
  // Delivery capacity
  utilization_pct      // billable hours / available hours
  realization_pct      // billable hours that were invoiced and collected
  billable_hours

  // Money
  revenue_usd
  gross_margin_pct

  // Selling
  deals_won
  deal_value_usd
  win_rate_pct
  pipeline_coverage    // open pipeline value / the target it has to cover

  // Delivery quality
  on_time_delivery_pct
  project_margin_pct
}

enum KpiPeriod {
  month
  quarter
  year
}

// Where a company stands with the platform.
//
// `suspended` and `cancelled` are kept apart on purpose: suspended is the
// platform withholding access (unpaid, or a decision), cancelled is the
// company having left. They look the same to a blocked request and mean
// completely different things to whoever has to fix it.
enum SubscriptionStatus {
  trialing
  active
  past_due  // period ended, inside the grace window - still gets in
  suspended // no access, by the platform's decision
  cancelled // no access, by the company's
}

// Whether a person may sign in, and why not when they may not.
//
// Replaces the old `is_active` boolean rather than sitting beside it. Two
// fields answering "can this person get in" disagree the first time one write
// path forgets the other, and a boolean cannot tell "waiting to be let in"
// apart from "let in and then removed" - which are the two states an admin
// most needs to see differently.
enum UserStatus {
  pending   // signed up through an invite, waiting on an admin
  active
  suspended // was in, is not any more
}

// Who a platform announcement is for.
//
// Matched against a company's subscription status when the notice is read,
// rather than fanned out to a recipient table when it is published. A company
// that starts paying tomorrow should see the notice aimed at paying customers
// without anybody re-sending it.
enum AnnouncementAudience {
  all
  trialing
  active
}

/// Things worth telling somebody about.
///
/// A closed list, and deliberately a short one. Every entry here has a place in
/// the code that already runs; an event nothing fires is a switch on a settings
/// screen that does nothing, which teaches people the whole screen is decorative.
enum NotificationEvent {
  /// Directed: the person the work was handed to.
  task_assigned
  /// Broadcast: whoever signs timesheets off.
  time_awaiting_approval
  /// Broadcast: whoever watches the money.
  payment_recorded
  /// Broadcast: whoever can approve somebody joining.
  member_awaiting_approval
  /// Broadcast, from the nightly sweep.
  invoice_overdue
  /// Broadcast: whoever decides leave.
  leave_requested
  /// Directed: the person who asked.
  leave_decided
}

/// Which board a status belongs to.
enum WorkflowKind {
  task
  project
}

/// What a status MEANS to the system, as opposed to what it is called.
///
/// This is the part that makes renaming safe. Four places reason about status
/// rather than displaying it - completed_at is derived from a task reaching
/// done, the dashboard counts open tasks and active projects - and they all
/// compare the category. Rename "Done" to "Shipped" and add "In QA" and every
/// one of them stays correct.
enum StatusCategory {
  /// Not started.
  open
  /// Being worked on. "In QA" and "In review" are both this.
  active
  /// Stopped, but not finished. Waiting on somebody.
  blocked
  /// Finished, and counted as delivered. Stops the clock.
  done
  /// Finished, and NOT counted as delivered. Abandoned rather than delivered.
  cancelled
}

/// Who recorded an attendance row.
///
/// Worth keeping apart: "they clocked in" and "somebody wrote it down for them"
/// are different claims, and only one of them is the person's own.
enum AttendanceSource {
  self
  admin
}

enum LeaveStatus {
  pending
  approved
  rejected
  /// Withdrawn by the person who asked, before anybody decided.
  cancelled
}

enum PayrollStatus {
  /// Being put together. No money has moved.
  draft
  /// Paid. The payouts exist and the ledger has moved.
  completed
}

/// Where a loan stands as an arrangement.
///
/// What is still owed is computed from the instalments, never stored, so this
/// cannot contradict the money. A loan settles itself when the last instalment
/// is paid; closed is the manual case - ended by agreement or written off with
/// a balance remaining.
enum LoanStatus {
  active
  settled
  closed
}

/// What a conversation is.
///
/// A direct conversation is between exactly two people and is named after
/// whoever you are talking to; a group has a name of its own; a project thread
/// belongs to a project and is named after it.
enum ConversationType {
  direct
  group
  project
}
