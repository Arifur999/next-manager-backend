// Enum values are deliberately lowercase: they travel to the client as literal
// strings and are compared there, so the wire value and the TypeScript value
// stay the same thing.

enum Role {
  // Platform. Belongs to no company, provisions and meters them, and
  // deliberately cannot read any company's money.
  super_admin

  // Inside a company. admin is the top - there is no owner above it, so the
  // last admin in a company is protected from demotion (see user.service.ts).
  admin           // finance, company state, team, settings
  sales           // clients, leads, invoices out - brings the work in
  project_manager // turns won work into projects, assigns teams, owns schedule
  operations      // does the work, logs time, submits
}

enum Currency {
  USD
  BDT
}

enum AccountType {
  paypal
  payoneer
  stripe
  wise
  bank
  cash
  bkash
  nagad
  other
}

// Why a ledger row exists. The row points back at the record that caused it
// through source_type + source_id, so any balance can be explained.
enum LedgerSource {
  opening_balance
  payment
  expense
  team_payout
  owner_withdrawal
  exchange_out
  exchange_in
  due_received
  due_payment
  adjustment
}

enum ClientStatus {
  active
  inactive
  archived
}

enum LeadStage {
  new
  contacted
  proposal
  negotiating
  won
  lost
}

enum ProjectStatus {
  planning
  active
  on_hold
  completed
  cancelled
}

enum TaskStatus {
  todo
  in_progress
  in_review
  done
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum InvoiceStatus {
  draft
  sent
  partially_paid
  paid
  overdue
  cancelled
}

// "employee" categories are salary-like costs that should be excluded from
// operating-expense reporting; "general" is everything else.
enum ExpenseCategoryType {
  general
  employee
}

enum PayoutType {
  salary
  project_bonus
  commission
  reimbursement
}

enum WithdrawalType {
  personal
  reinvestment
}

// Direction of a due-payment movement, from the agency's point of view.
enum DueDirection {
  received // money came in from that person
  payment  // money went out to that person
}

enum CredentialAction {
  created
  updated
  viewed
  revealed
  deleted
}

// Where a stored USD -> BDT rate came from. An api rate is the mid-market rate
// and is only ever a suggestion; the rate actually received on an exchange is
// recorded on the exchange itself.
enum RateSource {
  api
  manual
}
