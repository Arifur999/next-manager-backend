// Money. The rule that shapes this whole file:
//
//   An account balance is never a stored number that code increments. Every
//   movement writes one AccountTransaction row, and a balance is
//   opening_balance + SUM(those rows). A stored balance drifts the first time a
//   write half-fails; a ledger cannot, and it can always explain itself.
//
// Currency model (chosen deliberately - see Payment below):
//   A client payment credits a USD account. BDT only comes into existence when
//   USD is actually exchanged, which is an ExchangeTransaction. Nothing
//   converts implicitly, so no figure is ever counted twice.

model Account {
  id             String      @id @default(uuid())
  organization_id String
  name           String
  type           AccountType
  currency       Currency
  /// The balance on the day the account was added to the system. Everything
  /// after that is ledger rows.
  opening_balance Decimal    @default(0) @db.Decimal(15, 2)
  is_active      Boolean     @default(true)
  notes          String      @default("")
  deleted_at     DateTime?
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  organization Organization         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  transactions AccountTransaction[]
  payments     Payment[]
  expenses     Expense[]
  payouts      TeamPayout[]
  withdrawals  OwnerWithdrawal[]
  due_transactions DueTransaction[]
  exchanges_from ExchangeTransaction[] @relation("ExchangeFrom")
  exchanges_to   ExchangeTransaction[] @relation("ExchangeTo")
  payroll_runs      PayrollRun[]
  loans             Loan[]
  loan_instalments  LoanInstalment[]
  distributions     ShareholderDistribution[]

  @@unique([organization_id, name])
  @@index([organization_id])
  @@index([organization_id, currency])
  @@map("accounts")
}

/// One row per movement of money into or out of an account.
///
/// `amount` is signed: positive is money in, negative is money out. Summing the
/// column is therefore the balance, with no direction column to get wrong.
///
/// Written only inside the same $transaction as the record that caused it, and
/// never edited afterwards - correcting a mistake means reversing it with a new
/// row, so the history stays true.
model AccountTransaction {
  id             String       @id @default(uuid())
  organization_id String
  account_id     String
  date           DateTime     @db.Date
  amount         Decimal      @db.Decimal(15, 2)
  currency       Currency
  source_type    LedgerSource
  /// Id of the Payment / Expense / TeamPayout / ... that produced this row.
  /// Null only for a manual adjustment.
  source_id      String?
  description    String       @default("")
  created_by     String?
  created_at     DateTime     @default(now())

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  /// Balances for a whole agency at once - the accounts screen, the dashboard,
  /// and the check that runs after every write touching money. The index above
  /// covers one account; this covers all of them without walking other
  /// tenants' ledger rows.
  @@index([organization_id, account_id])
  /// The balance query: one account, everything up to a date.
  @@index([account_id, date])
  /// Finding the ledger rows belonging to a record, e.g. to reverse them.
  @@index([source_type, source_id])
  @@map("account_transactions")
}

/// Income from a client, always in USD.
///
/// This credits a USD account and nothing else. `reporting_rate` and
/// `amount_bdt_reporting` exist so "how much did we earn in August, in BDT"
/// has a stable answer that does not move when today's rate moves - they are
/// NOT a currency conversion, and no BDT account is touched here. Real BDT
/// arrives through ExchangeTransaction.
model Payment {
  id             String    @id @default(uuid())
  organization_id String
  client_id      String
  project_id     String?
  invoice_id     String?
  date           DateTime  @db.Date
  amount_usd     Decimal   @db.Decimal(15, 2)
  /// USD -> BDT rate used for reporting this payment. Defaults to the agency's
  /// configured rate or the latest fetched one, and is frozen once saved.
  reporting_rate Decimal   @db.Decimal(12, 4)
  amount_bdt_reporting Decimal @db.Decimal(15, 2)
  /// Must be a USD account.
  account_id     String
  reference      String    @default("")
  notes          String    @default("")
  deleted_at     DateTime?
  deleted_by     String?
  created_by     String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  client  Client   @relation(fields: [client_id], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [project_id], references: [id], onDelete: SetNull)
  invoice Invoice? @relation(fields: [invoice_id], references: [id], onDelete: SetNull)
  account Account  @relation(fields: [account_id], references: [id], onDelete: Restrict)

  @@index([organization_id])
  @@index([organization_id, date(sort: Desc)])
  @@index([client_id])
  @@index([project_id])
  @@index([invoice_id])
  /// The account FK. Unindexed, every attempt to remove an account
  /// scans this whole table to check the constraint, and the join on a list
  /// screen has nothing to walk either.
  @@index([account_id])
  @@map("payments")
}

/// Moving USD into BDT. This is where BDT is created.
///
/// Writes two ledger rows in one transaction: USD out of `from_account`, BDT
/// into `to_account`. `rate` is the rate ACTUALLY received, which is normally
/// worse than the mid-market rate an API reports - the gap is the payment
/// processor's margin, and recording the real one is the difference between
/// books that reconcile and books that do not.
model ExchangeTransaction {
  id             String   @id @default(uuid())
  organization_id String
  date           DateTime @db.Date
  from_account_id String
  to_account_id  String
  amount_usd     Decimal  @db.Decimal(15, 2)
  rate           Decimal  @db.Decimal(12, 4)
  /// Withheld by the processor, in USD, before conversion.
  fee_usd        Decimal  @default(0) @db.Decimal(15, 2)
  /// (amount_usd - fee_usd) * rate, stored rather than recomputed so a later
  /// rounding-rule change cannot silently restate history.
  amount_bdt     Decimal  @db.Decimal(15, 2)
  notes          String   @default("")
  deleted_at     DateTime?
  created_by     String?
  created_at     DateTime @default(now())

  from_account Account @relation("ExchangeFrom", fields: [from_account_id], references: [id], onDelete: Restrict)
  to_account   Account @relation("ExchangeTo", fields: [to_account_id], references: [id], onDelete: Restrict)

  @@index([organization_id])
  @@index([organization_id, date(sort: Desc)])
  /// Both sides of an exchange point at an account.
  @@index([from_account_id])
  @@index([to_account_id])
  @@map("exchange_transactions")
}

/// Daily USD -> BDT mid-market rate, fetched by cron.
///
/// Global rather than per-agency: the mid-market rate is the same fact for
/// everyone. An agency that wants a different figure for reporting sets
/// Organization.default_usd_rate instead.
model CurrencyRate {
  id         String     @id @default(uuid())
  date       DateTime   @db.Date
  base       Currency   @default(USD)
  quote      Currency   @default(BDT)
  rate       Decimal    @db.Decimal(12, 4)
  source     RateSource @default(api)
  /// Which provider answered, so a suspicious figure can be traced.
  provider   String     @default("")
  created_at DateTime   @default(now())

  @@unique([date, base, quote, source])
  @@index([date(sort: Desc)])
  @@map("currency_rates")
}
