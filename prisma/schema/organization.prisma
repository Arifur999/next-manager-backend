// The tenant root. Every other model in the app carries organization_id, and
// every query is scoped by it - see middleware/checkAuth.ts, which resolves it
// once per request onto req.user.

model Organization {
  id           String   @id @default(uuid())
  name         String
  legal_name   String   @default("")
  email        String   @default("")
  phone        String   @default("")
  address      String   @default("")
  website      String   @default("")
  logo_url     String   @default("")
  /// Reporting currency for P&L and dashboard totals. Money is held in whatever
  /// currency its account is in; this is only how it gets summarised.
  base_currency Currency @default(BDT)
  /// Manual USD -> BDT override used for reporting when set. Null means fall
  /// back to the latest fetched CurrencyRate.
  default_usd_rate Decimal? @db.Decimal(12, 4)
  timezone     String   @default("Asia/Dhaka")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  users     User[]
  clients   Client[]
  kpi_targets KpiTarget[]
  leads     Lead[]
  projects  Project[]
  accounts  Account[]
  subscription Subscription?
  invites   TeamInvite[]
  lead_sources LeadSource[]

  @@map("organizations")
}

model User {
  id             String    @id @default(uuid())
  /// Null only for a super_admin, who belongs to no agency.
  organization_id String?
  email          String    @unique
  password       String
  full_name      String
  phone          String    @default("")
  avatar_url     String    @default("")
  role           Role      @default(operations)
  /// Anything but `active` cannot sign in - see checkAuth. Defaults to active
  /// because the admin-created path hands somebody a password directly; the
  /// invite path sets `pending` explicitly and waits for approval.
  status         UserStatus @default(active)
  email_verified Boolean   @default(false)
  /// Bumped on every password change and compared against the claim inside the
  /// access token, so a password change ends sessions that were already open.
  token_version  Int       @default(0)
  /// What this member may do WITHIN their role. Empty means "everything the
  /// role allows", so an existing user never loses access the day permissions
  /// ship.
  permissions    String[]  @default([])
  deleted_at     DateTime?
  deleted_by     String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  organization       Organization? @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  assigned_tasks     Task[]              @relation("TaskAssignee")
  project_memberships ProjectMember[]
  payouts            TeamPayout[]
  credential_access  CredentialAccessLog[]
  time_entries       TimeEntry[]         @relation("TimeEntryUser")
  capacity           Capacity?
  kpi_targets        KpiTarget[]         @relation("KpiTargetUser")
  activities         ActivityLog[]
  reset_tokens       PasswordResetToken[]

  @@index([organization_id])
  /// The team list, newest first.
  @@index([organization_id, created_at(sort: Desc)])
  @@index([email])
  @@map("users")
}

/// A one-time link for somebody who cannot sign in.
///
/// The token is stored HASHED, never in plaintext. A reset table read from a
/// database backup or a stray log would otherwise be a list of working keys to
/// every account that had asked for one - the same reason passwords are not
/// stored either.
///
/// A row per request rather than a column on User, so an audit can answer "how
/// many resets did this account ask for, and were any used" - the shape of an
/// account somebody is trying to take over.
model PasswordResetToken {
  id         String    @id @default(uuid())
  user_id    String
  /// SHA-256 of the token that was emailed. Unique so a lookup is one index
  /// hit rather than a scan through every outstanding request.
  token_hash String    @unique
  expires_at DateTime
  /// Set the moment it is spent. A token is single-use: the second attempt
  /// with the same link is refused even inside its expiry window, because a
  /// link that keeps working is a link that can be replayed from an inbox.
  used_at    DateTime?
  /// What asked for it. Not identifying anybody - it is here so a burst of
  /// requests from one place is visible afterwards.
  requested_ip String  @default("")
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /// Invalidating every outstanding token for one person, which happens on
  /// every successful reset.
  @@index([user_id])
  /// The nightly sweep for expired rows.
  @@index([expires_at])
  @@map("password_reset_tokens")
}

/// An invitation to join a company as an operations member.
///
/// Shaped exactly like PasswordResetToken, because it is the same kind of
/// thing: a one-time credential that arrives out of band. The token is stored
/// hashed for the same reason - an invite table read from a backup would
/// otherwise be a set of working keys into live companies.
///
/// Bound to one email address. The join form asks for a name and a password
/// and never for an email, so a link that leaks cannot be used to create an
/// account under somebody else's address.
///
/// The role is stored but not chosen by the person accepting: every invite is
/// for `operations`. Sales and project managers are created directly by an
/// admin, who is deciding to hand out that authority rather than emailing it.
model TeamInvite {
  id              String    @id @default(uuid())
  organization_id String
  email           String
  role            Role      @default(operations)
  /// SHA-256 of the token in the link. Unique so a lookup is one index hit.
  token_hash      String    @unique
  expires_at      DateTime
  /// Set when the account is created from it. Single-use: a link that keeps
  /// working is a link that can be replayed out of an inbox months later.
  used_at         DateTime?
  /// Set when an admin revokes it before it was used.
  revoked_at      DateTime?
  created_by      String?
  created_at      DateTime  @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  /// The outstanding-invites list.
  @@index([organization_id, used_at])
  /// Refusing a second invite to an address that already has one live.
  @@index([organization_id, email])
  @@map("team_invites")
}
