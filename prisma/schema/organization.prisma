// The tenant root. Every other model in the app carries organization_id, and
// every query is scoped by it - see middleware/checkAuth.ts, which resolves it
// once per request onto req.user.

model Organization {
  id           String   @id @default(uuid())
  name         String
  legal_name   String   @default("")
  email        String   @default("")
  phone        String   @default("")
  address      String   @default("")
  website      String   @default("")
  logo_url     String   @default("")
  /// Reporting currency for P&L and dashboard totals. Money is held in whatever
  /// currency its account is in; this is only how it gets summarised.
  base_currency Currency @default(BDT)
  /// Manual USD -> BDT override used for reporting when set. Null means fall
  /// back to the latest fetched CurrencyRate.
  default_usd_rate Decimal? @db.Decimal(12, 4)
  timezone     String   @default("Asia/Dhaka")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  users     User[]
  clients   Client[]
  leads     Lead[]
  projects  Project[]
  accounts  Account[]

  @@map("organizations")
}

model User {
  id             String    @id @default(uuid())
  /// Null only for a super_admin, who belongs to no agency.
  organization_id String?
  email          String    @unique
  password       String
  full_name      String
  phone          String    @default("")
  avatar_url     String    @default("")
  role           Role      @default(operations)
  is_active      Boolean   @default(true)
  email_verified Boolean   @default(false)
  /// Bumped on every password change and compared against the claim inside the
  /// access token, so a password change ends sessions that were already open.
  token_version  Int       @default(0)
  /// What this member may do WITHIN their role. Empty means "everything the
  /// role allows", so an existing user never loses access the day permissions
  /// ship.
  permissions    String[]  @default([])
  deleted_at     DateTime?
  deleted_by     String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  organization       Organization? @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  assigned_tasks     Task[]              @relation("TaskAssignee")
  project_memberships ProjectMember[]
  payouts            TeamPayout[]
  credential_access  CredentialAccessLog[]
  time_entries       TimeEntry[]         @relation("TimeEntryUser")
  capacity           Capacity?
  activities         ActivityLog[]

  @@index([organization_id])
  @@index([email])
  @@map("users")
}
