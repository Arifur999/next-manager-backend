// Projects, who is on them, and the work inside them.

model Project {
  id             String        @id @default(uuid())
  organization_id String
  client_id      String
  /// What this project is, from the catalogue. Optional: plenty of work does
  /// not map onto one thing being sold.
  service_id     String?
  name           String
  code           String
  description    String        @default("")
  /// Restrict, not SetNull: a status with projects on it cannot be deleted,
  /// only switched off. Deleting would have to move every project "somewhere",
  /// and that is a decision nobody asked to make.
  status_id      String
  start_date     DateTime?     @db.Date
  end_date       DateTime?     @db.Date
  /// What the client agreed to pay, in USD. Profitability compares this (and
  /// what was actually received) against team payouts and project expenses.
  contract_value_usd Decimal   @default(0) @db.Decimal(15, 2)
  /// Frozen at kickoff so scope drift has an original to be measured from.
  /// contract_value_usd moves when the deal changes; these do not, and the
  /// gap between them IS the scope-change rate.
  baseline_hours     Decimal   @default(0) @db.Decimal(10, 2)
  baseline_value_usd Decimal   @default(0) @db.Decimal(15, 2)
  /// Null means no baseline was ever taken. Without it, a project that was
  /// never baselined is indistinguishable from one baselined at zero, and
  /// every unbaselined project would report infinite overrun.
  baseline_set_at    DateTime?
  notes          String        @default("")
  deleted_at     DateTime?
  deleted_by     String?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  organization Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  status       WorkflowStatus  @relation(fields: [status_id], references: [id], onDelete: Restrict)
  client       Client          @relation(fields: [client_id], references: [id], onDelete: Restrict)
  service      Service?        @relation(fields: [service_id], references: [id], onDelete: Restrict)
  members      ProjectMember[]
  tasks        Task[]
  payments     Payment[]
  invoices     Invoice[]
  expenses     Expense[]
  payouts      TeamPayout[]
  credentials  Credential[]
  time_entries TimeEntry[]
  milestones   ProjectMilestone[]
  conversations Conversation[]
  links         ProjectLink[]

  /// Project codes are unique per agency, not globally.
  @@unique([organization_id, code])
  @@index([organization_id])
  @@index([organization_id, status_id])
  /// The FK itself. The composite above leads with organization_id, so it
  /// cannot serve a foreign-key check - that needs status_id leading.
  @@index([status_id])
  /// The projects list, in the order it is shown.
  @@index([organization_id, created_at(sort: Desc)])
  @@index([client_id])
  /// The FK.
  @@index([service_id])
  @@map("projects")
}

model ProjectMember {
  id             String   @id @default(uuid())
  organization_id String
  project_id     String
  user_id        String
  /// Free text ("Designer", "Lead dev") rather than an enum: agency roles vary
  /// per project and are not worth a migration each time.
  role_on_project String  @default("")
  created_at     DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([project_id, user_id])
  @@index([organization_id])
  @@index([user_id])
  @@map("project_members")
}

model Task {
  id             String       @id @default(uuid())
  organization_id String
  project_id     String
  title          String
  description    String       @default("")
  assignee_id    String?
  /// Restrict, like the project one: a status with work on it is switched
  /// off, never deleted.
  status_id      String
  priority       TaskPriority @default(medium)
  due_date       DateTime?    @db.Date
  completed_at   DateTime?
  deleted_at     DateTime?
  created_by     String?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  project      Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  status       WorkflowStatus @relation(fields: [status_id], references: [id], onDelete: Restrict)
  assignee     User?       @relation("TaskAssignee", fields: [assignee_id], references: [id], onDelete: SetNull)
  time_entries TimeEntry[]

  @@index([organization_id])
  @@index([project_id])
  /// "My tasks", and the dashboard's "due today".
  @@index([assignee_id, status_id])
  @@index([organization_id, due_date])
  /// The board, in the order the board actually sorts: unfinished first, then
  /// by due date. The largest measured win in the whole schema - 6.0ms -> 0.8ms
  /// on 12k tasks, because the sort is walked rather than performed.
  @@index([organization_id, status_id, due_date])
  /// The FK itself, for the same reason as on projects.
  @@index([status_id])
  @@map("tasks")
}

/// Where a project's work actually lives.
///
/// Links, not uploads. An agency's files are already in Drive, Figma and
/// GitHub; storing copies would mean a second place for them to go stale, and
/// the one that goes stale is always the copy. This is the same shape as
/// ClientLink, deliberately - a project and a client keep their material the
/// same way.
model ProjectLink {
  id             String    @id @default(uuid())
  organization_id String
  project_id     String
  label          String
  url            String
  notes          String    @default("")
  deleted_at     DateTime?
  created_by     String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  /// The project detail page: one project, newest first.
  @@index([project_id, created_at(sort: Desc)])
  @@map("project_links")
}
