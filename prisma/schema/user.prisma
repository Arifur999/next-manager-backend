// Users and workspaces.
//
// Every other model in the app hangs off `owner_id`. For an owner that is their
// own id; for a team member it points at the owner who invited them. One column
// is what makes every list, create and delete tenant-safe - see
// middleware/checkAuth.ts, which resolves it once per request.

model User {
  id             String        @id @default(uuid())
  // Null for an owner (they are their own workspace root). Set for every team
  // member. checkAuth collapses the two into IRequestUser.ownerId so services
  // never have to branch on it.
  owner_id       String?
  email          String        @unique
  password       String
  full_name      String
  phone          String        @default("")
  avatar_url     String        @default("")
  role           Role          @default(owner)
  status         AccountStatus @default(active)
  is_active      Boolean       @default(true)
  email_verified Boolean       @default(false)
  // Bumped on every password change, and compared against the claim inside the
  // access token. That is what ends sessions that were already open when the
  // password changed - without it, a stolen token outlives the reset.
  token_version  Int           @default(0)
  // What this member may do WITHIN their role. Empty means "everything the role
  // allows", so an existing user never loses access the day permissions ship.
  permissions    String[]      @default([])
  deleted_at     DateTime?
  deleted_by     String?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  owner   User?  @relation("WorkspaceMembers", fields: [owner_id], references: [id], onDelete: Cascade)
  members User[] @relation("WorkspaceMembers")

  @@index([owner_id])
  @@index([email])
  @@map("users")
}
